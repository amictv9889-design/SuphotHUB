local _AUTH_PATTERN = { 468, 570, 555, 531, 552, 567, 366, 363, 363 }

local function VerifySecurityKey(inputKey)
    if typeof(inputKey) ~= "string" or #inputKey ~= #_AUTH_PATTERN then
        return false
    end
    for i = 1, #_AUTH_PATTERN do
        if (string.byte(inputKey, i) + 73) * 3 ~= _AUTH_PATTERN[i] then
            return false
        end
    end
    return true
end

