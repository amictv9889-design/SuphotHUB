-- [2] Spatial Coordinate Resolver
-- ----------------------------------------------------
local function GetTargetHeadPosition(char)
    if not char then return nil end

    if HitboxController and HitboxController._boxes and HitboxController._boxes[char] then
        for _, boxData in ipairs(HitboxController._boxes[char]) do
            if boxData.Hitbox and (boxData.Hitbox.Name == "Bip01_Head" or boxData.Hitbox.BodyPart == 1) then
                if boxData.Part then return boxData.Part.Position end
            end
        end
    end

    local headBone = char:FindFirstChild("Bip01_Head", true)
    if headBone and headBone:IsA("Bone") then
        return headBone.TransformedWorldCFrame.Position
    end

    local headPart = char:FindFirstChild("Head")
    if headPart and headPart:IsA("BasePart") then
        return headPart.Position
    end

    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if root and root:IsA("BasePart") then
        return root.Position + Vector3.new(0, 2.2, 0)
    end

    return nil
end

if GunController then
    local rawReportHit = GunController._ReportHit
    if rawReportHit then
        GunController._ReportHit = function(self, bullet, target, hitPos, bodyPart, mass)
            if Settings.BodyToHead and target then
                local char = target.Character or (typeof(target) == "Instance" and (target:IsA("Model") and target or target.Parent))
                local realHeadPos = GetTargetHeadPosition(char)
                if realHeadPos then
                    hitPos = realHeadPos
                    bodyPart = "Head"
                else
                    bodyPart = "Head"
                end
            end
            return rawReportHit(self, bullet, target, hitPos, bodyPart, mass)
        end
    end
end

if HitboxController then
    local rawResolve = HitboxController.Resolve
    if rawResolve then
        HitboxController.Resolve = function(self, instance)
            local res = rawResolve(self, instance)
            if Settings.BodyToHead and res and res.Target and res.Target ~= LocalPlayer then
                return {
                    Target = res.Target,
                    BodyPart = "Head"
                }
            end
            return res
        end
    end
end

