        local targetThumbPos = active and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        local targetTrackColor = active and Color3.fromRGB(16, 185, 129) or Color3.fromRGB(30, 35, 50)
        local targetThumbColor = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 185, 200)
        local targetBorderColor = active and Color3.fromRGB(16, 185, 129) or Color3.fromRGB(28, 34, 48)

        if animate then
            TweenService:Create(thumb, tweenInfo, { Position = targetThumbPos, BackgroundColor3 = targetThumbColor }):Play()
            TweenService:Create(track, tweenInfo, { BackgroundColor3 = targetTrackColor }):Play()
            TweenService:Create(cStroke, tweenInfo, { Color = targetBorderColor }):Play()
        else
            thumb.Position = targetThumbPos
            thumb.BackgroundColor3 = targetThumbColor
            track.BackgroundColor3 = targetTrackColor
            cStroke.Color = targetBorderColor
        end
    end

    card.MouseButton1Click:Connect(function()
        active = not active
        updateSwitch(true)
        callback(active)
    end)

    updateSwitch(false)
    card.Parent = ButtonContainer
    return card
end

