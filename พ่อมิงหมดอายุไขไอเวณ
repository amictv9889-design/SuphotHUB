        SubmitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        SubmitBtn.Text = "ACCESS GRANTED"

        TweenService:Create(KeyFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = KeyFrame.Position + UDim2.new(0, 0, 0, -25),
            BackgroundTransparency = 1
        }):Play()

        task.delay(0.35, function()
            KeyFrame.Visible = false
            KeyFrame:Destroy()

            Settings.MenuVisible = true
            MainFrame.Visible = true
            MobileToggleBtn.Visible = true

            MobileToggleBtn.Size = UDim2.new(0, 0, 0, 0)
            TweenService:Create(MobileToggleBtn, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 50, 0, 50)
            }):Play()

            local targetPos = MainFrame.Position
            MainFrame.Position = targetPos - UDim2.new(0, 25, 0, 0)
            MainFrame.BackgroundTransparency = 0.6
            TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = targetPos,
                BackgroundTransparency = 0
            }):Play()
        end)
    else
        KeyStatusLabel.Text = "✖ คีย์ไม่ถูกต้อง! กรุณาลองใหม่อีกครั้ง"
        KeyStatusLabel.TextColor3 = Color3.fromRGB(255, 65, 80)
        KeyInputStroke.Color = Color3.fromRGB(255, 65, 80)

        task.delay(1.2, function()
            if not isKeyVerified and KeyInputStroke and KeyInputStroke.Parent then
                KeyInputStroke.Color = Color3.fromRGB(28, 34, 48)
            end
        end)

        local origPos = KeyFrame.Position
        task.spawn(function()
            for _ = 1, 3 do
                KeyFrame.Position = origPos + UDim2.new(0, -6, 0, 0)
                task.wait(0.04)
                KeyFrame.Position = origPos + UDim2.new(0, 6, 0, 0)
                task.wait(0.04)
            end
            KeyFrame.Position = origPos
            isVerifying = false
        end)
    end
end

local function HandlePasteKey()
    local pasted = false
    pcall(function()
        if getclipboard then
            local clip = getclipboard()
            if clip and type(clip) == "string" and #clip > 0 then
                KeyTextBox.Text = clip
                pasted = true
                KeyStatusLabel.Text = "วางคีย์จาก Clipboard เรียบร้อย"
                KeyStatusLabel.TextColor3 = Color3.fromRGB(0, 245, 212)
            end
        end
    end)
    if not pasted then
        KeyStatusLabel.Text = "ไม่มีข้อมูลใน Clipboard (กรุณากรอกคีย์)"
        KeyStatusLabel.TextColor3 = Color3.fromRGB(255, 180, 60)
    end
    TweenService:Create(KeyInputStroke, TweenInfo.new(0.2), { Color = Color3.fromRGB(0, 245, 212) }):Play()
end

SubmitBtn.MouseButton1Click:Connect(AttemptUnlock)
SubmitBtn.TouchTap:Connect(AttemptUnlock)

KeyTextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        AttemptUnlock()
    end
end)

PasteBtn.MouseButton1Click:Connect(HandlePasteKey)
PasteBtn.TouchTap:Connect(HandlePasteKey)

