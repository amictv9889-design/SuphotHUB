local function Update2DLine(line, pointA, pointB)
    local distance = (pointB - pointA).Magnitude
    local center = (pointA + pointB) / 2
    local angle = math.deg(math.atan2(pointB.Y - pointA.Y, pointB.X - pointA.X))
    line.Size = UDim2.new(0, distance, 0, 1.5)
    line.Position = UDim2.new(0, center.X, 0, center.Y)
    line.Rotation = angle
    line.Visible = true
end

local function GetClosestTargetHeadWithDistance()
    local bestHeadPos = nil
    local bestChar = nil
    local minFovDistance = Settings.AimlockFOV
    local camera = Workspace.CurrentCamera
    if not camera then return nil, nil end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil, nil end

    local viewportSize = camera.ViewportSize
    local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hum = char:FindFirstChildOfClass("Humanoid")

            if hum and hum.Health > 0 then
                local headPos = GetTargetHeadPosition(char)
                if headPos then
                    local meterDistance = (headPos - myRoot.Position).Magnitude / metersToStuds
                    
                    if meterDistance <= Settings.AimlockDistance then
                        local screenPos, onScreen = camera:WorldToViewportPoint(headPos)
                        
                        if onScreen then
                            local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            
                            if screenDist <= Settings.AimlockFOV and screenDist < minFovDistance then
                                minFovDistance = screenDist
                                bestHeadPos = headPos
                                bestChar = char
                            end
                        end
                    end
                end
            end
        end
    end

    return bestHeadPos, bestChar
end

local CurrentTargetChar = nil

RunService.RenderStepped:Connect(function()
    local camera = Workspace.CurrentCamera
    if not camera then return end

    local viewportSize = camera.ViewportSize
    local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    FOVCircle.Size = UDim2.new(0, Settings.AimlockFOV * 2, 0, Settings.AimlockFOV * 2)
    FOVCircle.Visible = Settings.Aimlock

    local activeHeadPos = nil

    if isKeyVerified and Settings.Aimlock and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local isValid = false
        if CurrentTargetChar and CurrentTargetChar.Parent then
            local hum = CurrentTargetChar:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local headPos = GetTargetHeadPosition(CurrentTargetChar)
                if headPos then
                    local screenPos, onScreen = camera:WorldToViewportPoint(headPos)
                    if onScreen then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if screenDist <= Settings.AimlockFOV * 1.5 then
                            isValid = true
                            activeHeadPos = headPos
                        end
                    end
                end
            end
        end

        if not isValid then
            activeHeadPos, CurrentTargetChar = GetClosestTargetHeadWithDistance()
        end

        if activeHeadPos then
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, activeHeadPos)
        end
    else
        CurrentTargetChar = nil
    end

    if Settings.Aimlock and Settings.Snapline and activeHeadPos then
        local screenPos, onScreen = camera:WorldToViewportPoint(activeHeadPos)
        if onScreen then
            Update2DLine(SnaplineFrame, screenCenter, Vector2.new(screenPos.X, screenPos.Y))
        else
            SnaplineFrame.Visible = false
        end
    else
        SnaplineFrame.Visible = false
    end
end)

